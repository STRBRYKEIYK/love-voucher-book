# Set these in Vercel: Project Settings > Environment Variables. Never commit real values.

# Telegram (free): message @BotFather to make a bot, then open https://api.telegram.org/bot<TOKEN>/getUpdates after messaging the bot to find your chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email (free) via Resend: sign up with your own email, create an API key
RESEND_API_KEY=
NOTIFY_EMAIL=

# WhatsApp to yourself via CallMeBot (optional): phone in international format, e.g. +63XXXXXXXXXX
CALLMEBOT_APIKEY=
NOTIFY_PHONE=
